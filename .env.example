# Copy this to .env.local and set your real R2 public URL.
# Base URL of the Cloudflare R2 public bucket (NO trailing slash, NO /notes).
# The sample loader appends "/notes" automatically.
# If left unset, the app falls back to local files in public/samples/salamander/notes/.
NEXT_PUBLIC_SAMPLES_BASE_URL=https://pub-XXXX.r2.dev
